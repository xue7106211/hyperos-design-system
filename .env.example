# 环境变量模板（勿提交真实密钥）
# TinaCMS — 当前仅支持本地文件系统模式
TINA_PUBLIC_IS_LOCAL=true

# TinaCloud 与生产鉴权尚未接入；不要在当前配置中添加凭据。

# Ask AI — 小米内网 Anthropic Messages 网关（仅服务端；勿提交真实 Key）
# 本地：取消注释并写入 .env.local；线上：Matrix 部署空间「编辑 → 主容器环境变量」（见 docs/deployment.md）
# 对应 curl：POST https://api.llm.mioffice.cn/anthropic/v1/messages
# MI_LLM_BASE_URL="https://api.llm.mioffice.cn/anthropic/v1"
# MI_LLM_API_KEY="sk-..."
# MI_LLM_MODEL="amber_ai/claude-sonnet-5"
# 设为 false 时强制关闭助手入口（即使已配置 Key）
# AI_CHAT_ENABLED=true

# Figma Token 绑定检查（/tools/token-check，仅服务端；勿提交真实 Token）
# 规格：docs/superpowers/specs/2026-11-09-figma-token-check-design.md
# 个人访问令牌（PAT），需要 file_content:read 权限；只能读取该账号有权限的文件
# FIGMA_ACCESS_TOKEN="figd_..."
# MIUIX UI Kit 文件 key，逗号分隔；不填时默认 7PVSm4yEbknNLFaqauI4EM
# TOKEN_CHECK_KIT_FILE_KEYS="7PVSm4yEbknNLFaqauI4EM"
# 设为 false 时关闭检查，API 返回 not-configured
# TOKEN_CHECK_ENABLED=true
